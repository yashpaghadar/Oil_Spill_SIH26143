   "source": [
    "# Oiled — Stage 2: SAR Segmentation Baseline (Colab Prototype)\n",
    "**2-Channel U-Net (ResNet-34) Trained on Part 3 SAR Dataset**  \n",
    "Target: Sentinel-1 SAR Dual-Pol (VV + VH) $\\rightarrow$ Binary Oil Spill Probability Mask  \n",
    "Dataset: `drive/MyDrive/SIH/Data/SAR/Part_3/02_Test_images_and_ground_truth.7z`"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 0: Mount Google Drive"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from google.colab import drive\n",
    "from pathlib import Path\n",
    "\n",
    "drive.mount(\"/content/drive\")\n",
    "\n",
    "ARCHIVE_PATH = Path(\"/content/drive/MyDrive/SIH/Data/SAR/Part_3/02_Test_images_and_ground_truth.7z\")\n",
    "if not ARCHIVE_PATH.exists():\n",
    "    found = list(Path(\"/content/drive/MyDrive\").rglob(\"02_Test_images_and_ground_truth.7z\"))\n",
    "    ARCHIVE_PATH = found[0] if found else None\n",
    "\n",
    "assert ARCHIVE_PATH is not None, \"Could not locate 02_Test_images_and_ground_truth.7z in Drive!\"\n",
    "print(f\"✓ Found archive: {ARCHIVE_PATH} ({ARCHIVE_PATH.stat().st_size / 1e6:.1f} MB)\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 1: Environment & GPU Check"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import torch\n",
    "import platform\n",
    "\n",
    "print(\"=== Oiled — Environment Check ===\")\n",
