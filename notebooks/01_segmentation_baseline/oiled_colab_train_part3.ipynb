   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 3: Fast Decompression to Local Colab SSD"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import subprocess\n",
    "from pathlib import Path\n",
    "\n",
    "LOCAL_DATA_DIR = Path(\"/content/data/part3\")\n",
    "LOCAL_DATA_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "existing_tifs = len(list(LOCAL_DATA_DIR.rglob(\"*.tif\")))\n",
    "if existing_tifs == 900:\n",
    "    print(f\"✓ Data already extracted ({existing_tifs} GeoTIFFs found). Skipping 7z.\")\n",
    "else:\n",
    "    print(f\"Decompressing {ARCHIVE_PATH.name} to {LOCAL_DATA_DIR}...\")\n",
    "    subprocess.run([\"7z\", \"x\", str(ARCHIVE_PATH), f\"-o{LOCAL_DATA_DIR}\", \"-y\"], check=True)\n",
    "    total_tifs = len(list(LOCAL_DATA_DIR.rglob(\"*.tif\")))\n",
    "    print(f\"Extraction complete. Total GeoTIFFs: {total_tifs}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 4: Dataset Structure Discovery & Exact Image-Mask Pairing\n",
    "In Part 3:\n",
    "- Images: `Images/<Category>/<id>.tif`\n",
    "- Masks:  `Mask/<Category>/<id>_segmentation.tif`"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "from pathlib import Path\n",
    "\n",
    "LOCAL_DATA_DIR = Path(\"/content/data/part3\")\n",
    "images_root = LOCAL_DATA_DIR / \"Images\"\n",
    "masks_root  = LOCAL_DATA_DIR / \"Mask\"\n",
    "\n",
    "paired_records = []\n",
    "for img_path in sorted(images_root.rglob(\"*.tif\")):\n",
    "    rel_path = img_path.relative_to(images_root)\n",
    "    category_folder = rel_path.parts[0]\n",
    "    category_lower = category_folder.lower()\n",
    "    \n",
    "    if \"lookalike\" in category_lower:\n",
    "        category = \"lookalike\"\n",
    "    elif \"no\" in category_lower:\n",
    "        category = \"clean\"\n",
    "    else:\n",
    "        category = \"oil\"\n",
    "\n",
    "    # Exact mask filename pattern: <id>_segmentation.tif\n",
    "    mask_path = masks_root / rel_path.parent / f\"{img_path.stem}_segmentation{img_path.suffix}\"\n",
    "    \n",
    "    if mask_path.exists():\n",
    "        paired_records.append({\n",
    "            \"scene_id\": f\"{category}_{img_path.stem}\",\n",
    "            \"category\": category,\n",
    "            \"image\": str(img_path),\n",
    "            \"mask\": str(mask_path)\n",
    "        })\n",
    "\n",
    "manifest_df = pd.DataFrame(paired_records)\n",
    "print(f\"✓ Successfully paired scenes: {len(manifest_df)} / 450\")\n",
    "print(\"\\nCategory distribution:\")\n",
    "print(manifest_df[\"category\"].value_counts().to_string())\n",
    "print(\"\\nSample paired record:\")\n",
    "print(manifest_df.head(2).to_dict(orient=\"records\"))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 5: Scene-Level Train / Validation Split"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from sklearn.model_selection import train_test_split\n",
    "from pathlib import Path\n",
    "\n",
    "OUT_DIR = Path(\"/content/outputs\")\n",
    "OUT_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "# Filter to Oil scenes for supervised segmentation baseline\n",
    "oil_df = manifest_df[manifest_df[\"category\"] == \"oil\"].reset_index(drop=True)\n",
    "print(f\"Total oil scenes: {len(oil_df)}\")\n",
    "\n",
    "# 85% Train (approx 127 scenes), 15% Validation (approx 23 scenes)\n",
    "train_df, val_df = train_test_split(oil_df, test_size=0.15, random_state=42, shuffle=True)\n",
    "train_df = train_df.reset_index(drop=True)\n",
    "val_df   = val_df.reset_index(drop=True)\n",
    "\n",
    "print(f\"✓ Train scenes: {len(train_df)} | Val scenes: {len(val_df)}\")\n",
    "manifest_df.to_csv(OUT_DIR / \"manifest_all.csv\", index=False)\n",
    "train_df.to_csv(OUT_DIR / \"train_scenes.csv\", index=False)\n",
    "val_df.to_csv(OUT_DIR / \"val_scenes.csv\", index=False)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 6: Dual-Channel SAR Preprocessing & Overlapping Tiler"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import rasterio\n",
    "from rasterio.errors import NotGeoreferencedWarning\n",
    "import albumentations as A\n",
    "from albumentations.pytorch import ToTensorV2\n",
    "from torch.utils.data import Dataset, DataLoader\n",
    "from tqdm.auto import tqdm\n",
    "import warnings\n",
    "warnings.filterwarnings(\"ignore\", category=NotGeoreferencedWarning)\n",
    "\n",
    "SAR_MIN, SAR_MAX = -40.0, 10.0\n",
    "TILE_SIZE = 512\n",
    "TILE_STRIDE = 384\n",
    "MAX_TILES_PER_SCENE = 25\n",
    "\n",
    "def read_sar(path: str) -> np.ndarray:\n",
    "    with rasterio.open(path) as src:\n",
    "        arr = src.read().astype(np.float32)  # (C, H, W)\n",
    "    if arr.shape[0] == 1:\n",
    "        arr = np.concatenate([arr, arr], axis=0)\n",
    "    arr = arr[:2]  # take first 2 channels (VV, VH)\n",
    "    arr = np.clip(arr, SAR_MIN, SAR_MAX)\n",
    "    arr = (arr - SAR_MIN) / (SAR_MAX - SAR_MIN)\n",
    "    return np.transpose(arr, (1, 2, 0))  # (H, W, 2)\n",
    "\n",
    "def read_mask(path: str) -> np.ndarray:\n",
    "    with rasterio.open(path) as src:\n",
    "        m = src.read(1).astype(np.uint8)\n",
    "    return np.clip(m, 0, 1)\n",
    "\n",
    "def extract_tiles(img, mask, tile_size=TILE_SIZE, stride=TILE_STRIDE):\n",
    "    H, W = img.shape[:2]\n",
    "    for y in range(0, max(H - tile_size + 1, 1), stride):\n",
    "        for x in range(0, max(W - tile_size + 1, 1), stride):\n",
    "            it = img[y:y+tile_size, x:x+tile_size]\n",
    "            mt = mask[y:y+tile_size, x:x+tile_size] if mask is not None else np.zeros((tile_size, tile_size), np.uint8)\n",
    "            if it.shape[:2] == (tile_size, tile_size):\n",
    "                yield it, mt\n",
    "\n",
    "AUG_TRAIN = A.Compose([\n",
    "    A.HorizontalFlip(p=0.5),\n",
    "    A.VerticalFlip(p=0.5),\n",
    "    A.RandomRotate90(p=0.5),\n",
    "    A.GaussNoise(var_limit=(0.002, 0.015), p=0.3),\n",
    "    ToTensorV2()\n",
    "])\n",
    "AUG_VAL = A.Compose([ToTensorV2()])\n",
    "\n",
    "class SARSpiDataset(Dataset):\n",
    "    def __init__(self, df, augment=True):\n",
    "        self.aug = AUG_TRAIN if augment else AUG_VAL\n",
    "        self.tiles = []\n",
    "        tag = \"train\" if augment else \"val\"\n",
    "        print(f\"Pre-caching 512x512 tiles for {tag} ({len(df)} scenes)...\")\n",
    "        for _, row in tqdm(df.iterrows(), total=len(df), desc=tag):\n",
    "            try:\n",
    "                img = read_sar(row[\"image\"])\n",
    "                mask = read_mask(row[\"mask\"])\n",
    "                count = 0\n",
    "                for it, mt in extract_tiles(img, mask):\n",
    "                    self.tiles.append((it.copy(), mt.copy()))\n",
    "                    count += 1\n",
    "                    if count >= MAX_TILES_PER_SCENE: break\n",
    "            except Exception as e:\n",
    "                print(f\"  Skip: {Path(row[\'image\']).name}: {e}\")\n",
    "        print(f\"  [{tag}] Loaded {len(self.tiles)} tiles.\")\n",
    "\n",
    "    def __len__(self):\n",
    "        return len(self.tiles)\n",
    "\n",
    "    def __getitem__(self, idx):\n",
    "        img, mask = self.tiles[idx]\n",
    "        out = self.aug(image=img, mask=mask)\n",
    "        return out[\"image\"].float(), out[\"mask\"].float().unsqueeze(0)\n",
    "\n",
    "train_ds = SARSpiDataset(train_df, augment=True)\n",
    "val_ds   = SARSpiDataset(val_df,   augment=False)\n",
    "\n",
    "train_loader = DataLoader(train_ds, batch_size=16, shuffle=True,  num_workers=2, pin_memory=True, drop_last=True)\n",
    "val_loader   = DataLoader(val_ds,   batch_size=16, shuffle=False, num_workers=2, pin_memory=True)\n",
    "print(f\"Batches per epoch: Train={len(train_loader)} | Val={len(val_loader)}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 7: U-Net Architecture & BCE+Dice Loss"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import torch.nn as nn\n",
    "import segmentation_models_pytorch as smp\n",
    "\n",
    "model = smp.Unet(\n",
    "    encoder_name=\"resnet34\",\n",
    "    encoder_weights=None,\n",
    "    in_channels=2,\n",
    "    classes=1,\n",
    "    activation=None\n",
    ").to(DEVICE)\n",
    "\n",
    "class BCEDiceLoss(nn.Module):\n",
    "    def __init__(self, w=0.5, smooth=1.0):\n",
    "        super().__init__()\n",
    "        self.w = w\n",
    "        self.smooth = smooth\n",
    "        self.bce = nn.BCEWithLogitsLoss()\n",
    "    def dice(self, logits, target):\n",
    "        p = torch.sigmoid(logits)\n",
    "        num = 2.0 * (p * target).sum(dim=(2, 3)) + self.smooth\n",
    "        den = p.sum(dim=(2, 3)) + target.sum(dim=(2, 3)) + self.smooth\n",
    "        return 1.0 - (num / den).mean()\n",
    "    def forward(self, logits, target):\n",
    "        return self.w * self.bce(logits, target) + (1.0 - self.w) * self.dice(logits, target)\n",
    "\n",
    "def calc_iou(logits, target, thresh=0.5, eps=1e-6):\n",
    "    p = (torch.sigmoid(logits) > thresh).float()\n",
    "    inter = (p * target).sum()\n",
    "    union = p.sum() + target.sum() - inter\n",
    "    return ((inter + eps) / (union + eps)).item()\n",
    "\n",
    "def calc_dice(logits, target, thresh=0.5, eps=1e-6):\n",
    "    p = (torch.sigmoid(logits) > thresh).float()\n",
    "    return ((2.0 * (p * target).sum() + eps) / (p.sum() + target.sum() + eps)).item()\n",
    "\n",
    "criterion = BCEDiceLoss(w=0.5)\n",
    "optimizer = torch.optim.AdamW(model.parameters(), lr=1e-4, weight_decay=1e-4)\n",
    "scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=20)\n",
    "scaler    = torch.cuda.amp.GradScaler(enabled=torch.cuda.is_available())\n",
    "print(\"Model and loss functions ready.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 8: Training Loop (Mixed Precision)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import time\n",
    "\n",
    "EPOCHS = 20\n",
    "best_val_iou = 0.0\n",
    "\n",
    "print(\"=== Starting U-Net Training ===\")\n",
    "for epoch in range(1, EPOCHS + 1):\n",
    "    t0 = time.time()\n",
    "    model.train()\n",
    "    tr_loss = 0.0\n",
    "    for xb, yb in train_loader:\n",
    "        xb, yb = xb.to(DEVICE), yb.to(DEVICE)\n",
    "        optimizer.zero_grad()\n",
    "        with torch.cuda.amp.autocast(enabled=torch.cuda.is_available()):\n",
    "            logits = model(xb)\n",
    "            loss = criterion(logits, yb)\n",
    "        scaler.scale(loss).backward()\n",
    "        scaler.step(optimizer)\n",
    "        scaler.update()\n",
    "        tr_loss += loss.item()\n",
    "    tr_loss /= len(train_loader)\n",
    "\n",
    "    model.eval()\n",
    "    va_loss = va_iou = va_dice = 0.0\n",
    "    with torch.no_grad():\n",
    "        for xb, yb in val_loader:\n",
    "            xb, yb = xb.to(DEVICE), yb.to(DEVICE)\n",
    "            with torch.cuda.amp.autocast(enabled=torch.cuda.is_available()):\n",
    "                logits = model(xb)\n",
    "                va_loss += criterion(logits, yb).item()\n",
    "            va_iou  += calc_iou(logits, yb)\n",
    "            va_dice += calc_dice(logits, yb)\n",
    "    va_loss /= len(val_loader)\n",
    "    va_iou  /= len(val_loader)\n",
    "    va_dice /= len(val_loader)\n",
    "    scheduler.step()\n",
    "\n",
    "    elapsed = time.time() - t0\n",
    "    print(f\"Epoch {epoch:2d}/{EPOCHS} | Tr Loss: {tr_loss:.4f} | Val Loss: {va_loss:.4f} | Val IoU: {va_iou:.4f} | Val Dice: {va_dice:.4f} | {elapsed:.0f}s\")\n",
    "\n",
    "    if va_iou > best_val_iou:\n",
    "        best_val_iou = va_iou\n",
    "        torch.save({\n",
    "            \"epoch\": epoch,\n",
    "            \"model_state\": model.state_dict(),\n",
    "            \"val_iou\": best_val_iou,\n",
    "            \"val_dice\": va_dice\n",
    "        }, OUT_DIR / \"seg_best.pt\")\n",
    "        print(f\"  ✓ Checkpoint saved (IoU: {best_val_iou:.4f})\")\n",
    "\n",
    "print(f\"\\nTraining complete! Best Validation IoU: {best_val_iou:.4f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 9: ONNX Export & Google Drive Backup"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import shutil\n",
    "\n",
    "# Export to ONNX\n",
    "export_model = smp.Unet(\"resnet34\", encoder_weights=None, in_channels=2, classes=1, activation=\"sigmoid\").to(DEVICE).eval()\n",
    "ckpt = torch.load(OUT_DIR / \"seg_best.pt\", map_location=DEVICE)\n",
    "export_model.load_state_dict(ckpt[\"model_state\"])\n",
    "\n",
    "dummy = torch.randn(1, 2, 512, 512, device=DEVICE)\n",
    "onnx_path = OUT_DIR / \"unet_segmentation.onnx\"\n",
    "torch.onnx.export(\n",
    "    export_model, dummy, str(onnx_path),\n",
    "    input_names=[\"sar_tile\"], output_names=[\"oil_probability\"],\n",
    "    dynamic_axes={\"sar_tile\": {0: \"batch\"}, \"oil_probability\": {0: \"batch\"}},\n",
    "    opset_version=17\n",
    ")\n",
    "print(f\"✓ Exported ONNX: {onnx_path} ({onnx_path.stat().st_size / 1e6:.1f} MB)\")\n",
    "\n",
    "# Backup to Google Drive\n",
    "DRIVE_OUT = Path(\"/content/drive/MyDrive/SIH/models/prototype_v0.1\")\n",
    "DRIVE_OUT.mkdir(parents=True, exist_ok=True)\n",
    "for f in [\"seg_best.pt\", \"unet_segmentation.onnx\", \"manifest_all.csv\"]:\n",
    "    p = OUT_DIR / f\n",
    "    if p.exists():\n",
    "        shutil.copy2(p, DRIVE_OUT / f)\n",
    "        print(f\"✓ Persisted to Google Drive: {DRIVE_OUT / f}\")"
   ]
  }
